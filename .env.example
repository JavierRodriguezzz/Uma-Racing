# Copia este archivo como .env y ajusta los valores. .env NO se sube al repositorio.

# ---- Base de datos (MariaDB / XAMPP) ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=uma_racing
DB_USER=root
DB_PASSWORD=

# ---- Seguridad ----
# Cadena aleatoria de al menos 32 caracteres. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRA_HORAS=8

# ---- Reglas de negocio ----
MONEDAS_REGISTRO=100
ANUNCIOS_MAX_DIA=5
PARTIDAS_RECOMPENSA_MAX_DIA=30

# ---- Google Pay ----
# TEST: usa las tarjetas de prueba de Google y no cobra nada.
# PRODUCTION requeriría cuenta de comerciante y una pasarela de pago (no implementado).
GOOGLE_PAY_ENTORNO=TEST
GOOGLE_PAY_COMERCIO=UmaRacing Online
GOOGLE_PAY_MERCHANT_ID=
ORDEN_PAGO_MINUTOS=15

# ---- Tiempo de juego ----
TIEMPO_BLOQUE_SEG=300
TIEMPO_MONEDAS_BLOQUE=5
TIEMPO_MONEDAS_MAX_DIA=60

# ---- Apuestas (juego responsable) ----
APUESTA_MIN=10
APUESTA_MAX=500
APUESTA_PERDIDA_MAX_DIA=1500

# ---- Servidor ----
# true: FastAPI también sirve frontend/ y el juego compilado (desarrollo local)
SERVIR_FRONTEND=true
CORS_ORIGINS=
