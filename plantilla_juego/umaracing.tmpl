            <div class="uc-barra"><div id="uc-progreso"></div></div>
            <div class="uc-fila"><span class="uc-estado" id="uc-estado">PREPARANDO LA PISTA…</span><span id="uc-pct">0%</span></div>
            <button class="uc-start" id="uc-start" hidden>▶ PRESS START</button>
            <div class="uc-tip" id="uc-tip">Jugador 1: alterna A y D lo más rápido que puedas.</div>
        </div>
    </div>

    <script>
    (() => {
        // La carga real la reporta pygbag en #progress, #status e #infobox; aquí solo se traduce a esta pantalla.
        const $ = (id) => document.getElementById(id);
        const TIPS = [
            "Jugador 1: alterna A y D lo más rápido que puedas.",
            "Jugador 2: alterna ← y → para correr.",
            "Gana carreras como Jugador 1 para sumar monedas y puntos.",
            "Desbloquea a El Condor Pasa y Jungle Pocket en la tienda o en el gachapón.",
            "Cada 5 minutos de juego activo te dan monedas extra.",
            "¿Apostaste a tu tiempo? Tu siguiente victoria decide el reto.",
        ];
        let pct = 0, tip = 0, listo = false, terminado = false, visto = false;
        const fijar = (valor, texto) => {
            pct = Math.max(pct, Math.min(100, valor));
            $("uc-progreso").style.width = pct + "%";
            $("uc-corredora").style.left = pct + "%";
            $("uc-pct").textContent = Math.round(pct) + "%";
            if (texto) $("uc-estado").textContent = texto;
        };
        const rotar = setInterval(() => { tip = (tip + 1) % TIPS.length; $("uc-tip").textContent = TIPS[tip]; }, 3500);
        let falso = 0;
        const revisar = setInterval(() => {
            const box = document.getElementById("infobox");
            const prog = document.getElementById("progress");
            const texto = (box && box.innerText) || "";
            if (box && box.style.display === "block") visto = true;
            // pygbag oculta su aviso cuando el juego ya corre (con o sin el paso "PRESS START")
            if (box && box.style.display === "none" && (visto || listo)) return cerrar();
            if (/PRESS START|Ready to start/i.test(texto)) {
                if (!listo) {
                    listo = true;
                    fijar(100, "¡LISTO!");
                    $("uc-start").hidden = false;
                    $("uc-tip").textContent = "Haz clic para activar el sonido y el teclado.";
                    clearInterval(rotar);
                }
                return;
            }
            if (/installing/i.test(texto)) return fijar(Math.max(pct, 82) + 0.4, "INSTALANDO EL MOTOR…");
            if (prog && prog.max > 0 && prog.value > 0 && prog.value < prog.max) return fijar(10 + 65 * (prog.value / prog.max), "DESCARGANDO…");
            // Avance suave mientras se compila el intérprete (no reporta progreso)
            falso += 0.25;
            fijar(Math.min(78, 4 + falso), pct < 40 ? "PREPARANDO LA PISTA…" : "CALENTANDO MOTORES…");
        }, 120);
        function cerrar() {
            if (terminado) return;
            terminado = true;
            clearInterval(revisar);
            clearInterval(rotar);
            $("uma-carga").classList.add("fuera");
            setTimeout(() => $("uma-carga").remove(), 600);
            const c = document.getElementById("canvas");
            if (c) c.focus();
        }
        // El clic en "PRESS START" cuenta como interacción del usuario (requisito del navegador para el audio)
        $("uc-start").addEventListener("click", () => {
            $("uc-start").textContent = "¡A CORRER!";
            $("uc-estado").textContent = "ARRANCANDO…";
            setTimeout(() => { if (!terminado) cerrar(); }, 4000);
        });
        setTimeout(() => {
            if (listo || terminado) return;
            $("uma-carga").classList.add("error");
            $("uc-tip").textContent = "Está tardando más de lo normal. Revisa tu conexión a internet o recarga el juego.";
        }, 45000);
    })();
    </script>


